{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    }
  ],
  "schedule": ["before 6am on saturday"],
  "timezone": "America/Chicago",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "assignees": ["@hef"]
}
